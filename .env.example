# Supabase server-side configuration untuk deploy Vercel
# Isi di Vercel Project Settings > Environment Variables
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_dari_supabase

# Optional: boleh diisi kalau nanti frontend perlu akses langsung ke Supabase
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_key_dari_supabase
